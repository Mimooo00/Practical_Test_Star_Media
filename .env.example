# Copy this file to .env and adjust as needed.
# Docker Compose works without .env by using its built-in defaults.

APP_PORT=8080
PMA_PORT=8081
APP_URL=http://localhost:8080
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_IP_SALT=change-this-local-salt

DB_ROOT_PASS=root_pass
DB_USER=share_app
DB_PASS=share_pass
